---
layout: base.njk
---

<article>
  <header class="article-header">
    <h1>{{ title }}</h1>
    <p class="article-meta">
      <time datetime="{{ date | dateFilter('yyyy-MM-dd') }}">
        {{ date | dateFilter('MMMM dd, yyyy') }}
      </time>
    </p>
  </header>

  <div class="article-content">
    {{ content | safe }}
  </div>

  <footer class="article-footer">
    <p><a href="/articles">← Back to articles</a></p>
  </footer>
</article>
