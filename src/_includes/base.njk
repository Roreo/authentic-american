<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{% if description %}{{ description }}{% else %}Authentic American - A simple blog about things that matter.{% endif %}">
  <meta name="author" content="Authentic American">
  <meta name="theme-color" content="#f5f5f0">
  <title>{% if title %}{{ title }} - {% endif %}Authentic American</title>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="canonical" href="https://authenticamericangoods.com{{ page.url or '/' }}">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FQDBDLD6K6"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-FQDBDLD6K6');
  </script>
</head>
<body>
  <header>
    <h1><a href="/">Authentic American</a></h1>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/articles">Articles</a></li>
        <li><a href="/tags">Tags</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/links">Links</a></li>
      </ul>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <p>&copy; 2026 Authentic American. All rights reserved.</p>
  </footer>

  <script src="/assets/js/search.js"></script>
</body>
</html>
